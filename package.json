{
  "name": "@full-stack-assets/buildgraph",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative control plane for governed, runtime-independent agentic work.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run lint && npm run typecheck && npm run validate:registry && npm run validate:graph && npm test",
    "validate:registry": "node --import tsx scripts/validate-registry.ts",
    "generate:graph": "node --import tsx scripts/generate-graph.ts",
    "validate:graph": "node --import tsx scripts/generate-graph.ts",
    "preflight": "node --import tsx scripts/preflight.ts",
    "clickup:verify": "node --import tsx scripts/clickup-verify.ts",
    "adapters:health": "node --import tsx scripts/canon-adapters.ts health",
    "adapters:capabilities": "node --import tsx scripts/canon-adapters.ts capabilities",
    "adapter:write": "node --import tsx scripts/canon-adapters.ts write",
    "adapter:infer": "node --import tsx scripts/canon-adapters.ts infer",
    "iphone:instruction": "node --import tsx scripts/canon-adapters.ts phone-instruction",
    "sync:once": "node --import tsx scripts/canon-sync.ts --once",
    "sync:daemon": "node --import tsx scripts/canon-sync.ts",
    "retrieve:once": "node --import tsx scripts/canon-retrieval-agent.ts --once",
    "retrieve:daemon": "node --import tsx scripts/canon-retrieval-agent.ts",
    "serverless:sync": "CANON_STORAGE_BACKEND=supabase node --import tsx scripts/canon-sync.ts --once",
    "serverless:retrieve": "CANON_STORAGE_BACKEND=supabase node --import tsx scripts/canon-retrieval-agent.ts --once"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@github/copilot-sdk": "^1.0.11"
  },
  "peerDependenciesMeta": {
    "@github/copilot-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
