{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/policy-spec.schema.json",
  "title": "BuildGraph PolicySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "PolicySpec"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"type": "string", "enum": ["draft", "approved", "suspended", "retired"]},
        "owner": {"$ref": "common.schema.json#/$defs/owner"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "scope", "rules", "escalation", "validation"],
      "properties": {
        "purpose": {"type": "string", "minLength": 15},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applies_to"],
          "properties": {
            "applies_to": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["role", "skill", "integration", "workflow", "task", "runtime", "artifact", "approval"]}}
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "effect", "condition", "required_behavior"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
              "effect": {"type": "string", "enum": ["allow", "deny", "require_approval", "require_evidence", "require_escalation"]},
              "condition": {"type": "string", "minLength": 1},
              "required_behavior": {"type": "string", "minLength": 1}
            }
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "triggers"],
          "properties": {
            "owner": {"$ref": "common.schema.json#/$defs/owner"},
            "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtures"],
          "properties": {
            "fixtures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
