{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/skill-spec.schema.json",
  "title": "BuildGraph SkillSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "SkillSpec"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/skillId"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"$ref": "common.schema.json#/$defs/skillStatus"},
        "owner": {"$ref": "common.schema.json#/$defs/owner"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "inputs", "outputs", "limitations", "allowed_runtimes", "evaluation", "escalation"],
      "properties": {
        "purpose": {"type": "string", "minLength": 15},
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_runtimes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/runtimeId"}
        },
        "tool_restrictions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instructions": {"type": "string"},
            "scripts": {"type": "array", "items": {"type": "string"}},
            "references": {"type": "array", "items": {"type": "string"}},
            "assets": {"type": "array", "items": {"type": "string"}}
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fixtures", "acceptance_criteria"],
          "properties": {
            "fixtures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "regression_threshold": {"type": "string", "minLength": 1}
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triggers"],
          "properties": {
            "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
