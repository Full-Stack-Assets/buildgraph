{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/portfolio-spec.schema.json",
  "title": "BuildGraph PortfolioSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "PortfolioSpec"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "name": {"type": "string", "minLength": 3},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"type": "string", "enum": ["draft", "active", "paused", "archived"]},
        "owner": {"$ref": "common.schema.json#/$defs/owner"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "governance_owner", "project_ids", "default_policy_refs"],
      "properties": {
        "purpose": {"type": "string", "minLength": 15},
        "governance_owner": {"$ref": "common.schema.json#/$defs/owner"},
        "project_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/projectId"}},
        "default_policy_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
