{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/graph-edge.schema.json",
  "title": "BuildGraph Edge",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "target", "type", "provenance"],
  "properties": {
    "id": {"type": "string", "pattern": "^edge:[a-f0-9]{20,64}$"},
    "source": {"type": "string", "minLength": 3},
    "target": {"type": "string", "minLength": 3},
    "type": {"$ref": "relationship-type.schema.json"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "source_uri", "confidence"],
      "properties": {
        "collector": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    }
  }
}
