{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/role-spec.schema.json",
  "title": "BuildGraph RoleSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "RoleSpec"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/roleId"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"$ref": "common.schema.json#/$defs/roleStatus"},
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["library_module", "source_role_id"],
          "properties": {
            "library_module": {"type": "string", "minLength": 1},
            "source_role_id": {"$ref": "common.schema.json#/$defs/roleId"}
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_class", "primary_domain", "risk_tier", "authority_ceiling", "accountable_human_owner", "technical_owner", "mission", "scope", "input_contract", "skills", "integrations", "runtime_compatibility", "quality_gates", "escalation", "observability"],
      "properties": {
        "operating_class": {"$ref": "common.schema.json#/$defs/operatingClass"},
        "primary_domain": {"type": "string", "minLength": 1},
        "risk_tier": {"$ref": "common.schema.json#/$defs/riskTier"},
        "authority_ceiling": {"$ref": "common.schema.json#/$defs/integrationTier"},
        "accountable_human_owner": {"$ref": "common.schema.json#/$defs/owner"},
        "technical_owner": {"$ref": "common.schema.json#/$defs/owner"},
        "mission": {"type": "string", "minLength": 15},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["included", "excluded"],
          "properties": {
            "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "excluded": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_statuses", "data_classifications"],
          "properties": {
            "accepted_statuses": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/workStatus"}},
            "data_classifications": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/dataClassification"}}
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/skillId"},
              "config_ref": {"type": "string"}
            }
          }
        },
        "integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "max_tier"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/integrationId"},
              "max_tier": {"$ref": "common.schema.json#/$defs/integrationTier"}
            }
          }
        },
        "runtime_compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred", "allowed", "prohibited"],
          "properties": {
            "preferred": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/runtimeId"}},
            "allowed": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/runtimeId"}},
            "prohibited": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/runtimeId"}}
          }
        },
        "quality_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion", "owner"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"},
              "criterion": {"type": "string", "minLength": 1},
              "owner": {"$ref": "common.schema.json#/$defs/owner"}
            }
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triggers"],
          "properties": {
            "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_events"],
          "properties": {
            "required_events": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "spec": {
            "type": "object",
            "properties": {
              "risk_tier": {"enum": ["high", "restricted"]}
            },
            "required": ["risk_tier"]
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "type": "object",
            "properties": {
              "authority_ceiling": {"enum": ["I0", "I1", "I2"]}
            }
          }
        }
      }
    }
  ]
}
