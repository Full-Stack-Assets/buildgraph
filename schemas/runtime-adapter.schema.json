{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/runtime-adapter.schema.json",
  "title": "BuildGraph RuntimeAdapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "RuntimeAdapter"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/runtimeId"},
        "name": {"type": "string", "minLength": 1},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"type": "string", "enum": ["draft", "pilot", "approved", "suspended", "retired"]},
        "owner": {"$ref": "common.schema.json#/$defs/owner"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "input", "output", "tools", "authority", "durability", "observability", "controls"],
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime_id",
            "supported_models",
            "supported_tools",
            "supports_mcp",
            "supports_files",
            "supports_repo_context",
            "supports_persistent_memory",
            "supports_scheduled_execution",
            "supports_background_execution",
            "supports_structured_output",
            "permission_model",
            "context_limits",
            "artifact_support",
            "authentication_model",
            "known_constraints",
            "evidence_state",
            "supported_agent_definition_ids"
          ],
          "properties": {
            "runtime_id": {"$ref": "common.schema.json#/$defs/runtimeId"},
            "supported_models": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "supported_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "supports_mcp": {"type": "boolean"},
            "supports_files": {"type": "boolean"},
            "supports_repo_context": {"type": "boolean"},
            "supports_persistent_memory": {"type": "boolean"},
            "supports_scheduled_execution": {"type": "boolean"},
            "supports_background_execution": {"type": "boolean"},
            "supports_structured_output": {"type": "boolean"},
            "permission_model": {"type": "string", "minLength": 1},
            "context_limits": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "max_context_tokens", "notes"],
              "properties": {
                "mode": {"type": "string", "enum": ["known", "provider_defined", "model_dependent", "deployment_defined"]},
                "max_context_tokens": {"type": ["integer", "null"], "minimum": 1},
                "notes": {"type": "string", "minLength": 1}
              }
            },
            "artifact_support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "authentication_model": {"type": "string", "minLength": 1},
            "known_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "evidence_state": {"$ref": "common.schema.json#/$defs/evidenceState"},
            "supported_agent_definition_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "common.schema.json#/$defs/agentDefinitionId"}
            }
          }
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported_artifact_types", "structured_input"],
          "properties": {
            "supported_artifact_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "structured_input": {"type": "boolean"},
            "context_limit_note": {"type": "string"},
            "redaction_behavior": {"type": "string", "minLength": 1}
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structured_result", "receipt_format", "failure_classification"],
          "properties": {
            "structured_result": {"type": "boolean"},
            "receipt_format": {"type": "string", "minLength": 1},
            "failure_classification": {"type": "boolean"}
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supports_typed_tools", "allowlist_method", "interception"],
          "properties": {
            "supports_typed_tools": {"type": "boolean"},
            "allowlist_method": {"type": "string", "minLength": 1},
            "interception": {"type": "string", "minLength": 1}
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_supported_tier", "can_create_drafts", "can_create_pull_requests", "requires_native_confirmation"],
          "properties": {
            "maximum_supported_tier": {"$ref": "common.schema.json#/$defs/integrationTier"},
            "can_create_drafts": {"type": "boolean"},
            "can_create_pull_requests": {"type": "boolean"},
            "requires_native_confirmation": {"type": "boolean"}
          }
        },
        "durability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asynchronous", "resumption", "idempotency_support"],
          "properties": {
            "asynchronous": {"type": "boolean"},
            "resumption": {"type": "string", "minLength": 1},
            "idempotency_support": {"type": "string", "minLength": 1}
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trace_fields", "cost_fields"],
          "properties": {
            "trace_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "cost_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secret_handling", "revocation", "failure_mode"],
          "properties": {
            "secret_handling": {"type": "string", "minLength": 1},
            "revocation": {"type": "string", "minLength": 1},
            "failure_mode": {"const": "fail_closed"}
          }
        }
      }
    }
  }
}
