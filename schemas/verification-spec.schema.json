{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/verification-spec.schema.json",
  "title": "BuildGraph VerificationSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "api_version": {
      "const": "buildgraph/v1"
    },
    "kind": {
      "const": "VerificationSpec"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/verificationId"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/canonicalStatus"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/owner"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "evidence_ids",
        "artifact_ids",
        "capability_ids",
        "verifier",
        "verified_at",
        "findings"
      ],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/evidenceState"
        },
        "method": {
          "type": "string",
          "minLength": 5
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/evidenceId"
          }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/architectureArtifactId"
          }
        },
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/capabilityId"
          }
        },
        "verifier": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
