{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/constraint-spec.schema.json",
  "title": "BuildGraph ConstraintSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "api_version": {
      "const": "buildgraph/v1"
    },
    "kind": {
      "const": "ConstraintSpec"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/constraintId"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/canonicalStatus"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/owner"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "scope",
        "enforcement",
        "severity",
        "policy_ids",
        "organization_ids",
        "division_ids",
        "product_ids",
        "project_ids",
        "agent_definition_ids",
        "runtime_ids"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 15
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "schema",
            "compiler",
            "validator",
            "policy",
            "human_approval"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "advisory",
            "required",
            "blocking"
          ]
        },
        "policy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "organization_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/organizationId"
          }
        },
        "division_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/divisionId"
          }
        },
        "product_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/productId"
          }
        },
        "project_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/projectId"
          }
        },
        "agent_definition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/agentDefinitionId"
          }
        },
        "runtime_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/runtimeId"
          }
        }
      }
    }
  }
}
