{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/division-spec.schema.json",
  "title": "BuildGraph DivisionSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "api_version": {
      "const": "buildgraph/v1"
    },
    "kind": {
      "const": "DivisionSpec"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/divisionId"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/canonicalStatus"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/owner"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "purpose",
        "operating_classes",
        "functional_domains",
        "autonomy_ceiling",
        "integration_ceiling",
        "role_definition_ids",
        "capability_ids",
        "product_ids",
        "evidence_requirements"
      ],
      "properties": {
        "organization_id": {
          "$ref": "common.schema.json#/$defs/organizationId"
        },
        "purpose": {
          "type": "string",
          "minLength": 15
        },
        "operating_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/operatingClass"
          }
        },
        "functional_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/functionalDomain"
          }
        },
        "autonomy_ceiling": {
          "$ref": "common.schema.json#/$defs/autonomyTier"
        },
        "integration_ceiling": {
          "$ref": "common.schema.json#/$defs/integrationTier"
        },
        "role_definition_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/roleId"
          }
        },
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/capabilityId"
          }
        },
        "product_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/productId"
          }
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
