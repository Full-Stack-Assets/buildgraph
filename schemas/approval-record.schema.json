{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/approval-record.schema.json",
  "title": "BuildGraph ApprovalRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.1"},
    "kind": {"const": "ApprovalRecord"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "task_id", "created_at", "status"],
      "properties": {
        "approval_id": {"$ref": "common.schema.json#/$defs/approvalId"},
        "task_id": {"$ref": "common.schema.json#/$defs/taskId"},
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["prepared", "approved", "rejected", "expired", "revoked"]}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_preview", "risk_tier", "approver", "authority_scope", "conditions", "expires_at", "evidence_refs", "execution_boundary"],
      "properties": {
        "action_preview": {"type": "string", "minLength": 15},
        "risk_tier": {"$ref": "common.schema.json#/$defs/riskTier"},
        "approver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "authority_basis"],
          "properties": {
            "identity": {"$ref": "common.schema.json#/$defs/owner"},
            "authority_basis": {"type": "string", "minLength": 1}
          }
        },
        "authority_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_integration_tier", "permitted_action"],
          "properties": {
            "maximum_integration_tier": {"$ref": "common.schema.json#/$defs/integrationTier"},
            "permitted_action": {"type": "string", "minLength": 1}
          }
        },
        "conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expires_at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "execution_boundary": {"type": "string", "enum": ["prepare_only", "native_human_confirmation", "disabled_in_v0"]},
        "execution_receipt_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
