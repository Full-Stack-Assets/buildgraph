{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/autonomous-retrieval-jobs.schema.json",
  "title": "Canon Autonomous Retrieval Jobs",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs"],
  "properties": {
    "jobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jobId", "adapterId", "intervalMs", "request", "grant"],
        "properties": {
          "jobId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
          "adapterId": {"type": "string", "enum": ["grok", "gemini", "copilot"]},
          "intervalMs": {"type": "integer", "minimum": 60000, "maximum": 2592000000},
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prompt", "systemInstruction", "resourceRefs", "idempotencyKey", "approvalRef", "metadata"],
            "properties": {
              "prompt": {"type": "string", "minLength": 1, "maxLength": 1048576},
              "systemInstruction": {"type": ["string", "null"], "maxLength": 65536},
              "resourceRefs": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
              "idempotencyKey": {"type": "string", "minLength": 3, "maxLength": 256},
              "approvalRef": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
              "metadata": {"type": "object", "maxProperties": 100, "additionalProperties": true}
            }
          },
          "grant": {
            "allOf": [
              {"$ref": "data-action-grant.schema.json"},
              {
                "type": "object",
                "properties": {
                  "operations": {
                    "type": "array",
                    "contains": {"const": "inference"}
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
