{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/product-spec.schema.json",
  "title": "BuildGraph ProductSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "api_version": {
      "const": "buildgraph/v1"
    },
    "kind": {
      "const": "ProductSpec"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "status",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/productId"
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "version": {
          "$ref": "common.schema.json#/$defs/semanticVersion"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/canonicalStatus"
        },
        "owner": {
          "$ref": "common.schema.json#/$defs/owner"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_id",
        "home_division_id",
        "purpose",
        "capability_ids",
        "project_ids",
        "evidence_state"
      ],
      "properties": {
        "organization_id": {
          "$ref": "common.schema.json#/$defs/organizationId"
        },
        "home_division_id": {
          "$ref": "common.schema.json#/$defs/divisionId"
        },
        "purpose": {
          "type": "string",
          "minLength": 15
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/capabilityId"
          }
        },
        "project_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/projectId"
          }
        },
        "evidence_state": {
          "$ref": "common.schema.json#/$defs/evidenceState"
        }
      }
    }
  }
}
