{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/graph-entity.schema.json",
  "title": "BuildGraph Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "canonical_name", "type", "version", "status", "source", "source_uri", "created_at", "updated_at", "provenance", "confidence", "tags", "metadata"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._-]{1,255}$"},
    "canonical_name": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "source_uri": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "source_uri", "confidence"],
      "properties": {
        "collector": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "minLength": 1},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object"}
  }
}
