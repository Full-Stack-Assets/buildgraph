{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildgraph.local/schemas/project-spec.schema.json",
  "title": "BuildGraph ProjectSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "buildgraph/v0.2"},
    "kind": {"const": "ProjectSpec"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "status", "owner"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/projectId"},
        "name": {"type": "string", "minLength": 3},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "status": {"type": "string", "enum": ["draft", "active", "paused", "archived"]},
        "owner": {"$ref": "common.schema.json#/$defs/owner"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portfolio_id", "purpose", "domain", "systems_of_record", "authority", "data_handling"],
      "properties": {
        "portfolio_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        "purpose": {"type": "string", "minLength": 15},
        "domain": {"type": "string", "minLength": 1},
        "systems_of_record": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "purpose", "authority"],
            "properties": {
              "system": {"type": "string", "minLength": 1},
              "purpose": {"type": "string", "minLength": 1},
              "authority": {"type": "string", "enum": ["canonical", "reference", "artifact_store", "work_queue"]}
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_integration_tier", "approval_policy_ref"],
          "properties": {
            "maximum_integration_tier": {"$ref": "common.schema.json#/$defs/integrationTier"},
            "approval_policy_ref": {"type": "string", "minLength": 1}
          }
        },
        "data_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permitted_classifications", "retention_policy_ref"],
          "properties": {
            "permitted_classifications": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/dataClassification"}},
            "retention_policy_ref": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
