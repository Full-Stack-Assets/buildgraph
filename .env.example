# ClickUp Mission Control Public API adapter
# Never commit a real token. Copy this file to a local .env or inject values through your runtime secret manager.
CLICKUP_API_TOKEN=<inject-securely>
CLICKUP_WORKSPACE_ID=90141126753

# Optional transport/runtime controls
# CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2
BUILDGRAPH_CLICKUP_IDEMPOTENCY_PATH=.runtime/clickup-idempotency.json
BUILDGRAPH_CLICKUP_CONCURRENCY=2
BUILDGRAPH_CLICKUP_MAX_PENDING=100
BUILDGRAPH_CLICKUP_PENDING_LEASE_MS=900000

# Canon provider/device data fabric
# Select only configured adapters. Read sync is enabled by selection; writes and inference are separate kill switches.
CANON_SYNC_ADAPTERS=grok
CANON_STORAGE_BACKEND=file
CANON_SYNC_ROOT=/absolute/private/path/to/canon-sync
CANON_SYNC_INTERVAL_MS=300000
CANON_SYNC_MAX_PAGES=100
CANON_SYNC_LEASE_TTL_MS=600000
CANON_SINK_MAX_ITEM_BYTES=67108864
CANON_ENABLE_WRITES=false
CANON_ENABLE_INFERENCE=false
CANON_REQUIRE_INFERENCE_APPROVAL=false

# One-off governed actions read payloads only from this absolute root and persist idempotency/audit evidence under CANON_SYNC_ROOT.
CANON_ACTION_PAYLOAD_ROOT=/absolute/private/path/to/canon-action-payloads
CANON_ACTION_LEASE_TTL_MS=600000
CANON_ACTION_COMMAND_MAX_BYTES=2097152

# Autonomous retrieval (requires CANON_ENABLE_INFERENCE=true and short-lived grants in the jobs file)
CANON_RETRIEVAL_JOBS_FILE=/absolute/private/path/to/canon-retrieval-jobs.json
CANON_RETRIEVAL_JOBS_MAX_BYTES=8388608
CANON_RETRIEVAL_POLL_MS=60000
CANON_RETRIEVAL_LEASE_TTL_MS=600000
CANON_INFERENCE_EVIDENCE_MAX_BYTES=8388608

# xAI Grok Files, Collections, and Responses API
XAI_API_KEY=<inject-securely>
XAI_MANAGEMENT_API_KEY=<inject-separately-if-collections-are-written>
XAI_COLLECTION_IDS=collection_REPLACE_ME
XAI_MODEL=<deployment-selected-model>
XAI_MAX_ITEM_BYTES=52428800
XAI_COLLECTION_POLL_MS=1000
XAI_COLLECTION_TIMEOUT_MS=300000

# Google Gemini Files, File Search, and Interactions API
GEMINI_API_KEY=<inject-securely>
GEMINI_FILE_SEARCH_STORES=fileSearchStores/REPLACE_ME
GEMINI_MODEL=<deployment-selected-model>
GEMINI_MAX_ITEM_BYTES=52428800
GEMINI_OPERATION_POLL_MS=1000
GEMINI_OPERATION_TIMEOUT_MS=300000

# GitHub Copilot SDK/CLI (install @github/copilot-sdk and authenticate the Copilot CLI separately)
COPILOT_WORKING_DIRECTORY=/absolute/scoped/working-directory
COPILOT_MODEL=auto
COPILOT_MAX_EVENT_BYTES=16777216
COPILOT_RESPONSE_TIMEOUT_MS=360000

# Apple CloudKit Web Services. The custom-zone adapter requires the private database and a delegated, renewable user web-auth token.
CLOUDKIT_CONTAINER_ID=iCloud.com.example.CanonPhoneBridge
CLOUDKIT_ENVIRONMENT=development
CLOUDKIT_DATABASE=private
CLOUDKIT_API_TOKEN=<inject-securely>
CLOUDKIT_WEB_AUTH_TOKEN=<inject-short-lived-delegated-token>
CLOUDKIT_ZONE_NAME=CanonSyncZone
CLOUDKIT_RECORD_TYPES=CanonDocument,CanonWriteInstruction,CanonWriteReceipt
CLOUDKIT_ASSET_HOST_ALLOWLIST=.icloud-content.com,.apple-cloudkit.com
CLOUDKIT_MAX_ASSET_BYTES=15728640

# Ephemeral GitHub Actions mode (set CANON_STORAGE_BACKEND=supabase; omit for local file mode)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<inject-securely>
SUPABASE_STORAGE_BUCKET=canon-objects
SUPABASE_MAX_ITEM_BYTES=67108864
